---
import { heroTopics } from '../../data/profile';
const topicsJson = JSON.stringify(heroTopics.map(({ id, label, heading, todo, body }) => ({ id, label, heading, todo, body })));
---

<section class="hero-wrap container">
  <div class="hero-head">
    <p class="hero-head__kicker">Senior Software Engineer · Barcelona · 14+ yrs</p>
    <h1 class="hero-head__title">
      Coding &amp; Software Architecture <span class="muted">for the real world</span>
    </h1>
  </div>
  <agent-terminal data-topics={topicsJson}></agent-terminal>
  <noscript>
    <p class="muted">The interactive terminal needs JavaScript. The rest of the site works without it.</p>
  </noscript>
</section>

<script>
  import './agent-terminal.ts';
</script>

<style>
  .hero-wrap {
    height: calc(100vh - 56px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: var(--space-5);
    padding-bottom: var(--space-3);
  }
  .hero-head {
    flex: none;
    margin-bottom: var(--space-3);
    max-width: 640px;
  }
  .hero-head__kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--oc-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-3);
  }
  .hero-head__title {
    margin: 0;
    line-height: 1.15;
  }
  .hero-head__title .muted {
    color: var(--oc-text-muted);
  }
  agent-terminal {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  @media (max-width: 760px) {
    .hero-wrap {
      height: auto;
      overflow: visible;
    }
    .hero-head { margin-bottom: var(--space-4); }
  }
</style>
