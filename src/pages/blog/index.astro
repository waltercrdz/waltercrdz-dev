---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../../components/BlogList.astro';
import { getPublishedPosts, getAllTags } from '../../lib/posts';

const posts = await getPublishedPosts();
const allTags = getAllTags(posts);
---

<BaseLayout title="Blog — Walter Cardozo" description="Writing on backend engineering, software architecture, and AI coding agents.">
  <div class="container blog-index">
    <header class="blog-index__head">
      <p class="section__label">// blog</p>
      <h1>Writing</h1>
      <p class="muted">Notes on backend engineering, software architecture, and the AI coding-agent wave.</p>
    </header>

    {allTags.length > 0 && (
      <nav class="blog-index__tags" aria-label="Tags">
        {allTags.map((t) => (
          <a class="tag" href={`/blog/tag/${t}/`}>#{t}</a>
        ))}
      </nav>
    )}

    {posts.length === 0 ? (
      <p class="muted blog-index__empty">
        No posts yet — check back soon. <span class="cursor">▋</span>
      </p>
    ) : (
      <BlogList posts={posts} />
    )}
  </div>
</BaseLayout>

<style>
  .blog-index { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .blog-index__head { margin-bottom: var(--space-5); }
  .blog-index__head h1 { margin: 0 0 var(--space-3); }
  .blog-index__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); }
  .blog-index__empty { font-family: var(--font-mono); }
  .cursor { color: var(--oc-primary); animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
</style>
