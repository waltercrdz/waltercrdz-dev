---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogList from '../../../components/BlogList.astro';
import { getPublishedPosts, getAllTags } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Blog — Walter Cardozo`} description={`Posts tagged ${tag}.`}>
  <div class="container blog-index">
    <header class="blog-index__head">
      <a href="/blog" class="back-link">← back to blog</a>
      <p class="section__label">// tag</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    </header>
    <BlogList posts={posts} />
  </div>
</BaseLayout>

<style>
  .blog-index { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .blog-index__head { margin-bottom: var(--space-5); }
  .back-link { font-family: var(--font-mono); font-size: 0.85rem; color: var(--oc-text-muted); }
  .back-link:hover { color: var(--oc-primary); }
  .blog-index__head h1 { margin: var(--space-2) 0 var(--space-3); }
</style>
