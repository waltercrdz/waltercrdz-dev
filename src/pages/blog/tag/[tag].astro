---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Blog — Walter Cardozo`} description={`Posts tagged ${tag}.`}>
  <div class="container blog-index">
    <header class="blog-index__head">
      <a href="/blog" class="back-link">← back to blog</a>
      <p class="section__label">// tag</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    </header>
    <div class="blog-index__list">
      {posts.map((p) => (
        <PostCard
          href={`/blog/${p.id}/`}
          title={p.data.title}
          description={p.data.description}
          pubDate={p.data.pubDate}
          tags={p.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .blog-index__head { margin-bottom: var(--space-5); }
  .back-link { font-family: var(--font-mono); font-size: 0.85rem; color: var(--oc-text-muted); }
  .back-link:hover { color: var(--oc-primary); }
  .blog-index__head h1 { margin: var(--space-2) 0 var(--space-3); }
  .blog-index__list { display: grid; gap: var(--space-4); }
</style>
