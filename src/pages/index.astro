---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentTerminal from '../components/hero/AgentTerminal.astro';
import PostCard from '../components/PostCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <AgentTerminal />

  <section class="section container" id="experience">
    <div class="cols">
      <div class="cols__main">
        <p class="section__label">// experience</p>
        <h2>Where I've shipped</h2>
        <div class="exp-table" role="table">
          <div class="exp-row exp-row--head" role="row">
            <span class="exp-cell exp-cell--what" role="columnheader">What</span>
            <span class="exp-cell exp-cell--status" role="columnheader">Status</span>
          </div>
          {profile.experience.map((e) => (
            <div class="exp-row" role="row">
              <span class="exp-cell exp-cell--what" role="rowheader">
                <span class="exp__company">{e.company}</span>
                <span class="exp__role">{e.role}</span>
              </span>
              <span class="exp-cell exp-cell--status" role="cell">
                <span class="exp__period">{e.period}</span>
                <span class="exp__summary">{e.summary}</span>
                <span class="exp__tech">
                  {e.tech.map((t) => <span class="exp__tag">{t}</span>)}
                </span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section container" id="latest">
      <div class="cols">
        <div class="cols__main">
          <p class="section__label">// latest writing</p>
          <h2>From the blog</h2>
          <div class="latest">
            {posts.map((p) => (
              <PostCard
                href={`/blog/${p.id}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
              />
            ))}
          </div>
          <a href="/blog" class="latest__more">view all posts →</a>
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .section__label,
  h2,
  .exp-table,
  .latest__more {
    font-family: var(--font-mono);
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 1fr);
    gap: 1rem;
  }
  .cols__main { min-width: 0; }
  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; }
  }

  .exp-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 0;
    overflow: hidden;
    max-width: 100%;
  }
  .exp-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    border-bottom: 1px solid var(--oc-border-subtle);
  }
  .exp-row:last-child { border-bottom: none; }
  .exp-row--head { background: var(--oc-bg-element); }
  .exp-cell {
    padding: 0.65rem 0.85rem;
    border-right: 1px solid var(--oc-border-subtle);
  }
  .exp-cell:last-child { border-right: none; }

  .exp-row--head .exp-cell {
    color: var(--oc-accent);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .exp-cell--what {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .exp__role { color: var(--oc-text-muted); font-size: 0.82rem; }
  .exp__company { color: var(--oc-success); font-weight: 500; }

  .exp-cell--status {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--oc-text);
  }
  .exp__period { color: var(--oc-text-muted); font-size: 0.78rem; }
  .exp__summary { color: var(--oc-text); font-size: 0.88rem; line-height: 1.6; }
  .exp__tech { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.2rem; }
  .exp__tag {
    color: var(--oc-success);
    font-size: 0.74rem;
    border: 1px solid var(--oc-border-subtle);
    padding: 0.1rem 0.45rem;
    border-radius: 0;
  }

  @media (max-width: 760px) {
    .section { padding: var(--space-6) var(--space-5); }
    .exp-row--head { display: none; }
    .exp-row { grid-template-columns: 1fr; }
    .exp-cell { border-right: none; border-bottom: 1px solid var(--oc-border-subtle); }
    .exp-cell:last-child { border-bottom: none; }
  }

  .latest { display: grid; gap: var(--space-4); margin-bottom: var(--space-5); }
  .latest__more { font-size: 0.9rem; color: var(--oc-primary); }
</style>
