---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentTerminal from '../components/hero/AgentTerminal.astro';
import PostCard from '../components/PostCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <AgentTerminal />

  <section class="section container" id="about">
    <p class="section__label">// about</p>
    <div class="about">
      <div class="about__text">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>
      <aside class="about__facts">
        <div><span class="muted">location</span> {profile.location}</div>
        <div><span class="muted">current</span> {profile.company}</div>
        <div><span class="muted">education</span> {profile.education.school}</div>
        <div><span class="muted">languages</span> {profile.languages.map((l) => l.name).join(' · ')}</div>
      </aside>
    </div>
  </section>

  <section class="section container" id="skills">
    <p class="section__label">// skills</p>
    <h2>The toolbox</h2>
    <div class="skills">
      {profile.skills.map((g) => (
        <div class="skills__group">
          <h3>{g.group}</h3>
          <ul>
            {g.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section container" id="experience">
    <p class="section__label">// experience</p>
    <h2>Where I've shipped</h2>
    <div class="exp">
      {profile.experience.map((e) => (
        <article class="exp__item">
          <div class="exp__role">{e.role}</div>
          <div class="exp__company">{e.company}</div>
          <div class="exp__period">{e.period}</div>
          <p class="exp__summary">{e.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section container" id="certifications">
    <p class="section__label">// certifications</p>
    <h2>Credentials</h2>
    <div class="certs">
      {profile.certifications.map((c) => (
        <div class="certs__item">
          <div class="certs__title">{c.title}</div>
          <div class="certs__meta">{c.issuer} · {c.date}</div>
        </div>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section container" id="latest">
      <p class="section__label">// latest writing</p>
      <h2>From the blog</h2>
      <div class="latest">
        {posts.map((p) => (
          <PostCard
            href={`/blog/${p.id}/`}
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            tags={p.data.tags}
          />
        ))}
      </div>
      <a href="/blog" class="latest__more">view all posts →</a>
    </section>
  )}

  <section class="section container" id="contact">
    <p class="section__label">// contact</p>
    <h2>Let's connect</h2>
    <p class="muted">Reach out — happy to talk shop, share knowledge, or build something together.</p>
    <div class="contact">
      {profile.socials.map((s) => (
        <a class="contact__link" href={s.url} target="_blank" rel="noopener noreferrer">
          {s.label} →
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .about__facts {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--oc-text);
    border: 1px solid var(--oc-border-subtle);
    border-radius: var(--radius);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .about__facts .muted {
    display: inline-block;
    width: 5.5rem;
    color: var(--oc-text-muted);
  }
  @media (max-width: 720px) {
    .about { grid-template-columns: 1fr; }
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
  }
  .skills__group h3 { margin: 0 0 var(--space-3); }
  .skills__group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .skills__group li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    border: 1px solid var(--oc-border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    color: var(--oc-text);
  }

  .exp { display: grid; gap: var(--space-5); }
  .exp__item {
    border-left: 2px solid var(--oc-accent);
    padding-left: var(--space-4);
  }
  .exp__role { font-family: var(--font-mono); color: var(--oc-primary); font-size: 1rem; }
  .exp__company { color: var(--oc-text); font-weight: 600; }
  .exp__period { font-family: var(--font-mono); font-size: 0.8rem; color: var(--oc-text-muted); margin-bottom: var(--space-2); }
  .exp__summary { margin: 0; color: var(--oc-text-muted); }

  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-3);
  }
  .certs__item {
    border: 1px solid var(--oc-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .certs__title { font-size: 0.95rem; color: var(--oc-text); }
  .certs__meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--oc-text-muted); margin-top: 0.25rem; }

  .latest { display: grid; gap: var(--space-4); margin-bottom: var(--space-5); }
  .latest__more { font-family: var(--font-mono); font-size: 0.9rem; color: var(--oc-primary); }

  .contact { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
  .contact__link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    border: 1px solid var(--oc-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 1rem;
    color: var(--oc-text);
  }
  .contact__link:hover { border-color: var(--oc-primary); color: var(--oc-primary); }
</style>
